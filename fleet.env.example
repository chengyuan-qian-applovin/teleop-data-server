# Copy to fleet.env and edit. All settings for the teleop data server live
# in fleet.env — ./start.sh and the systemd service both read it.
# Keep it simple KEY=value (no quotes, no spaces).

FLEET_HOST=0.0.0.0
FLEET_PORT=899

# Where everything is stored: fleet.sqlite3 + scenes/ + episodes/.
FLEET_DATA_DIR=/absolute/path/to/fleet_data

# Shared secret; collectors send it as X-Fleet-Token. Empty = no auth (LAN only!).
FLEET_TOKEN=change-me

# Target successes for scenes created without an explicit target.
FLEET_DEFAULT_TARGET=20

# Cloud backup: destination (empty = disabled), interval, gcloud binary.
FLEET_SYNC_DEST=
FLEET_SYNC_INTERVAL_S=300
FLEET_GCLOUD=gcloud
